{
  "name": "lynk-guard",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A quiet, local-first phishing guard for Chrome.",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "feeds:update": "node scripts/update-feed.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "punycode": "2.3.1",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.0.0",
    "@types/punycode": "^2.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
